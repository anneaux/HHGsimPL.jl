    "let\n",
    "    row = 5\n",
    "    b = BeamTCNicola(row)\n",
    "    \n",
    "    all = Vector{Vector{Saddle}}()\n",
    "\n",
    "    ib_lims = get_ionisationburst_limits(b, Ip, collect(q_values)) \n",
    "\n",
    "    results = [Vector{Vector{Saddle}}() for _ in 1:Threads.nthreads()]\n",
    "    \n",
    "    Threads.@threads for q in q_values\n",
    "        \n",
    "        data_q = Vector{Saddle}()\n",
    "        for (idx,lims) in enumerate(ib_lims)\n",
    "        \n",
    "            ti_domain = ComplexDomain(lims[1], lims[2], 0.01,0.35)*TC;\n",
    "            tr_domain = ComplexDomain(lims[1]+0.1, lims[2] + 1., -0.35,0.35)*TC;\n",
    "    \n",
    "            saddles = find_saddles_sobol(q; b = b, Ip = Ip,ti_cd=ti_domain, tr_cd=tr_domain)\n",
    "            for s in saddles\n",
    "                rel = check_contribution(action_functions(b, Ip, q)..., s.ti, s.tr)\n",
    "                if rel \n",
    "                    push!(data_q,s)\n",
    "                end\n",
    "            end        \n",
    "\n",
    "        end\n",
    "        push!(results[Threads.threadid()], data_q)\n",
    "\n",
    "    end\n",
    "#     @show results[1]\n",
    "    for res_thread in results \n",
    "        for vec in res_thread\n",
    "            if !isempty(vec)\n",
    "                q = vec[1].q\n",
    "                push!(saddles_df, [data_cells_fld0[row, 1:2]...,\n",
    "                    q, \n",
    "                    [[s.ti, s.tr] for s in vec],\n",
    "                    [s.p for s in vec]\n",
    "                    ])\n",
    "            end\n",
    "                \n",
    "\n",
    "        end\n",
    "\n",
    "    end\n",
    "    all\n",
    "end;"
   ]
