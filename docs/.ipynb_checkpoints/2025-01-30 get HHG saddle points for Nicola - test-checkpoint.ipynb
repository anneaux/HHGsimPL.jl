   "source": [
    "let \n",
    "    f = Figure()\n",
    "\n",
    "    ax = Axis(f[1, 1], #title = \"θ = $θ, r = $(round(r, digits =3))\",\n",
    "        xlabel = \"time\",\n",
    "        ylabel = \"electric field\"\n",
    "    ) \n",
    "    \n",
    "    sg = SliderGrid(f[2, :], (label = \"θ\", range = θ_values), \n",
    "        (label = \"r\", range = r_values, startvalue = 1))\n",
    "    \n",
    "    θ = sg.sliders[1].value    \n",
    "    r = sg.sliders[2].value    \n",
    "    \n",
    "    beam = @lift BeamTCNicola($θ, $r)\n",
    "    \n",
    "    ### plot the electric field    \n",
    "    times = range(0, stop = 2*TC, length = 150)\n",
    "    field = @lift [E($beam)(t) for t in times]\n",
    "    \n",
    "    lines!(ax, times, @lift([f[1] for f in $field]), label = \"x\")\n",
    "    lines!(ax, times, @lift([f[2] for f in $field]), label = \"y\")\n",
    "    lines!(ax, times, @lift([f[3] for f in $field]), label = \"z\")\n",
    "    \n",
    "    lines!(ax, times, @lift([sqrt(sum(fpython.^2)) for f in $field]), label = \"intensity\")\n",
    "    ylims!(ax, -0.06,0.06)\n",
    "    \n",
    "    f[1, 2] = Legend(f, ax, \"electric field\", framevisible = false)\n",
    "    \n",
    "    ### plot the saddle points\n",
    "    matching_rows = @lift filter(row -> row.r == $r && row.θ == $θ, saddles_df_new, view =true)\n",
    "    \n",
    "    ax2 = Axis(f[1, 1], ylabel = \"harmonic order\")\n",
    "    \n",
    "    tis = @lift ([Point2f([real(s[1]), row.q]) for row in eachrow($matching_rows) for s in row.saddles ])\n",
    "    trs = @lift ([Point2f([real(s[2]), row.q]) for row in eachrow($matching_rows) for s in row.saddles ])\n",
    "    \n",
    "    colors = @lift [harmonic_color(real(row.q)) for row in eachrow($matching_rows) for s in row.saddles if nrow($matching_rows) > 0]\n",
    "\n",
    "\n",
    "    scatter!(ax2, tis, color = colors, marker = :circle)\n",
    "    scatter!(ax2, trs, color = :transparent, marker = :diamond, strokewidth = 1, strokecolor = colors)\n",
    "\n",
    "    ylims!(ax2, 10., 30)\n",
    "    \n",
    "    ax2.yaxisposition = :right\n",
    "    ax2.xlabelvisible = false\n",
    "    hidedecorations!(ax2, grid=true, label = false, ticklabels =false)\n",
    "    hidexdecorations!(ax2)\n",
    "    \n",
    "    linkxaxes!(ax,ax2)\n",
    "    display(scr1, f)\n",
    "#     f\n",
    "end"
   ]
  },
